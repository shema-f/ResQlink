# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform API key for live mapping and geocoding.
# Provided automatically in AI Studio or configured by the user.
VITE_GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY"

# --------------------------------------------------------------------------
# Prototype security controls (see README "Security & modes")
# --------------------------------------------------------------------------

# DISPATCH_API_KEY: shared secret required as the `x-dispatch-api-key` header
# on dispatch-level mutations (incident status changes, responder heartbeats,
# SMS send/webhook, DB connection tests).
# REQUIRED in production: without it those endpoints fail closed (503).
DISPATCH_API_KEY=""

# VITE_DISPATCH_API_KEY: browser-side copy of DISPATCH_API_KEY. Only set this
# if you intentionally trust the deployed dashboard to send dispatch requests.
VITE_DISPATCH_API_KEY=""

# DEMO_MODE: "true" enables simulated behaviours (OTP codes echoed to the
# caller, the fixed 123456 demo code). Defaults to true outside
# NODE_ENV=production; never enable it on a production path.
DEMO_MODE="true"

# CORS_ORIGIN: browser origin allowed to open Socket.IO when dispatch auth is
# enforced (production). Defaults to same-origin only.
CORS_ORIGIN="http://localhost:3000"

# PORT: API + web server port (default 3000)
PORT=3000

# DATABASE_URL: optional PostgreSQL/PostGIS connection string. When unset the
# server uses its in-memory WGS84 spatial store (demo data).
DATABASE_URL=""

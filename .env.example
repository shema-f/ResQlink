# resQlink environment configuration
# Copy to .env and fill in what you need: every variable is optional for the
# local demo (npm run dev). Never commit a real .env — it is git-ignored.

# ---------------------------------------------------------------------------
# Optional integrations
# ---------------------------------------------------------------------------

# GEMINI_API_KEY (or GOOGLE_API_KEY): enables the live Uwera AI copilot.
# Unset = the guided keyword fallback still works, fully offline.
GEMINI_API_KEY=""

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform key for the live mapping
# view. Unset = the app falls back to OpenStreetMap/Leaflet (no key needed).
VITE_GOOGLE_MAPS_API_KEY=""

# DATABASE_URL: PostgreSQL/PostGIS connection string. Unset = the server uses
# its in-memory WGS84 spatial store with fabricated demo data.
DATABASE_URL=""

# ---------------------------------------------------------------------------
# Prototype security controls (see README "Security & modes")
# ---------------------------------------------------------------------------

# DISPATCH_API_KEY: shared secret required as the `x-dispatch-api-key` header
# on dispatch-level mutations (incident status changes, responder heartbeats,
# SMS send/webhook, DB connection tests).
# REQUIRED in production: without it those endpoints fail closed (503).
DISPATCH_API_KEY=""

# VITE_DISPATCH_API_KEY: browser-side copy of DISPATCH_API_KEY. Only set this
# if you intentionally trust the deployed dashboard to send dispatch requests.
VITE_DISPATCH_API_KEY=""

# DEMO_MODE: "true" enables simulated behaviours (OTP codes echoed to the
# caller, the fixed 123456 demo code). Defaults to true outside
# NODE_ENV=production; never enable it on a production path.
DEMO_MODE="true"

# CORS_ORIGIN: browser origin allowed to open Socket.IO when dispatch auth is
# enforced (production). Defaults to same-origin only.
CORS_ORIGIN="http://localhost:3000"

# RATE_LIMIT_OTP / RATE_LIMIT_AI: requests per minute per client IP on the
# OTP request/verify endpoints and the AI assistant endpoint.
RATE_LIMIT_OTP="10"
RATE_LIMIT_AI="30"

# PORT: API + web server port (default 3000)
PORT=3000
